   "index": "aA",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Queue of {node, hd}. A map keyed by hd keeps\nthe columns sorted automatically.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Queue of {node, hd}. A map keyed by hd keeps\nthe columns sorted automatically.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t012",
   "type": "text",
   "x": 194.84,
   "y": 613.31,
   "width": 237.6,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1407525498,
   "version": 2,
   "versionNonce": 1362316964,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "queue<pair<Node*, int>> q;\nq.push({root, 0});\nauto [n, hd] = q.front();\nq.push({n->left, hd - 1});\nq.push({n->right, hd + 1});",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "queue<pair<Node*, int>> q;\nq.push({root, 0});\nauto [n, hd] = q.front();\nq.push({n->left, hd - 1});\nq.push({n->right, hd + 1});",
   "lineHeight": 1.25,
   "autoResize": true
  },
