  {
   "id": "t005",
   "type": "text",
   "x": 172.95,
   "y": 289.5,
   "width": 286.72,
   "height": 40.0,
   "angle": -0.0029,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1989837255,
   "version": 2,
   "versionNonce": 368609857,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a4",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Swap the children at every node.\nPost or pre order both work.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Swap the children at every node.\nPost or pre order both work.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t006",
   "type": "text",
   "x": 186.95,
   "y": 341.5,
   "width": 334.4,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 446484947,
   "version": 2,
   "versionNonce": 1299384747,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "void invert(Node *r) {\n    if (!r) return;\n    swap(r->left, r->right);\n    invert(r->left); invert(r->right);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "void invert(Node *r) {\n    if (!r) return;\n    swap(r->left, r->right);\n    invert(r->left); invert(r->right);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
