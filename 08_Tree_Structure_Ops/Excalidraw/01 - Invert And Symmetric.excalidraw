   "index": "aN",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "bool sub(Node *r, Node *t) {\n    if (!r) return false;\n    if (same(r, t)) return true;\n    return sub(r->left, t) || sub(r->right, t);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "bool sub(Node *r, Node *t) {\n    if (!r) return false;\n    if (same(r, t)) return true;\n    return sub(r->left, t) || sub(r->right, t);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
