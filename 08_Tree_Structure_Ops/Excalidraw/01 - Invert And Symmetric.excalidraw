   "index": "aA",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Compare the tree against itself with two\npointers moving outward in opposite ways.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Compare the tree against itself with two\npointers moving outward in opposite ways.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t012",
   "type": "text",
   "x": 194.8,
   "y": 680.53,
   "width": 299.2,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1523145127,
   "version": 2,
   "versionNonce": 957605140,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "bool sym(Node *a, Node *b) {\n    if (!a || !b) return a == b;\n    return a->val == b->val\n        && sym(a->left, b->right)\n        && sym(a->right, b->left);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "bool sym(Node *a, Node *b) {\n    if (!a || !b) return a == b;\n    return a->val == b->val\n        && sym(a->left, b->right)\n        && sym(a->right, b->left);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
