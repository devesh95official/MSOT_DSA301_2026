   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "while (cur) {\n    if (!cur->left) { cur = cur->right; continue; }\n    Node *p = cur->left;\n    while (p->right) p = p->right;\n    p->right = cur->right;\n    cur->right = cur->left; cur->left = nullptr;\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "while (cur) {\n    if (!cur->left) { cur = cur->right; continue; }\n    Node *p = cur->left;\n    while (p->right) p = p->right;\n    p->right = cur->right;\n    cur->right = cur->left; cur->left = nullptr;\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
