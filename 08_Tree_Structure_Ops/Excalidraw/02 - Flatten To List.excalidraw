  {
   "id": "t018",
   "type": "text",
   "x": 197.11,
   "y": 990.11,
   "width": 448.8,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
