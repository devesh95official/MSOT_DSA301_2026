   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "void flat(Node *r) {\n    if (!r) return;\n    flat(r->right); flat(r->left);\n    r->right = prev; r->left = nullptr;\n    prev = r;\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "void flat(Node *r) {\n    if (!r) return;\n    flat(r->right); flat(r->left);\n    r->right = prev; r->left = nullptr;\n    prev = r;\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
