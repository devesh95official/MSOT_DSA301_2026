   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a4",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Return the node where the two targets\nfirst end up on opposite sides.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Return the node where the two targets\nfirst end up on opposite sides.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t006",
   "type": "text",
   "x": 196.54,
   "y": 341.5,
   "width": 360.8,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 193523961,
   "version": 2,
   "versionNonce": 511363121,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "Node *lca(Node *r, Node *p, Node *q) {\n    if (!r || r == p || r == q) return r;\n    Node *l = lca(r->left, p, q);\n    Node *rr = lca(r->right, p, q);\n    return (l && rr) ? r : (l ? l : rr);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Node *lca(Node *r, Node *p, Node *q) {\n    if (!r || r == p || r == q) return r;\n    Node *l = lca(r->left, p, q);\n    Node *rr = lca(r->right, p, q);\n    return (l && rr) ? r : (l ? l : rr);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
