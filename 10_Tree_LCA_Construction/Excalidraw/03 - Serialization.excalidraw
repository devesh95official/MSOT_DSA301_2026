   "index": "aG",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Read tokens in the same order. A # returns null\nand consumes one token.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Read tokens in the same order. A # returns null\nand consumes one token.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t018",
   "type": "text",
   "x": 193.06,
   "y": 912.83,
   "width": 352.0,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 714247617,
   "version": 2,
   "versionNonce": 1837784986,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "Node *de(istringstream &in) {\n    string t; getline(in, t, ',');\n    if (t == \"#\") return nullptr;\n    Node *n = new Node(stoi(t));\n    n->left = de(in); n->right = de(in);\n    return n;\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Node *de(istringstream &in) {\n    string t; getline(in, t, ',');\n    if (t == \"#\") return nullptr;\n    Node *n = new Node(stoi(t));\n    n->left = de(in); n->right = de(in);\n    return n;\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
