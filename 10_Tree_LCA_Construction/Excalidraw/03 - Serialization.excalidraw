  {
   "id": "t012",
   "type": "text",
   "x": 190.64,
   "y": 580.18,
   "width": 334.4,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1314906992,
   "version": 2,
   "versionNonce": 711100276,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "void ser(Node *r, string &s) {\n    if (!r) { s += \"#,\"; return; }\n    s += to_string(r->val) + \",\";\n    ser(r->left, s); ser(r->right, s);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "void ser(Node *r, string &s) {\n    if (!r) { s += \"#,\"; return; }\n    s += to_string(r->val) + \",\";\n    ser(r->left, s); ser(r->right, s);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
