  {
   "id": "t011",
   "type": "text",
   "x": 176.39,
   "y": 566.15,
   "width": 421.12,
   "height": 40.0,
   "angle": -0.0011,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1645490001,
   "version": 2,
   "versionNonce": 1460011748,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aA",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Preorder front is the root. Find it in inorder:\neverything left of it is the left subtree.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Preorder front is the root. Find it in inorder:\neverything left of it is the left subtree.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t012",
   "type": "text",
   "x": 190.39,
   "y": 618.15,
   "width": 281.6,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1991374478,
   "version": 2,
   "versionNonce": 699348769,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "int root = pre[preIdx++];\nint mid = pos[root];\nn->left  = build(inLo, mid - 1);\nn->right = build(mid + 1, inHi);",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "int root = pre[preIdx++];\nint mid = pos[root];\nn->left  = build(inLo, mid - 1);\nn->right = build(mid + 1, inHi);",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t013",
   "type": "text",
   "x": 176.39,
   "y": 714.15,
   "width": 456.96,
   "height": 20.0,
   "angle": 0.0037,
   "strokeColor": "#1e1e1e",
