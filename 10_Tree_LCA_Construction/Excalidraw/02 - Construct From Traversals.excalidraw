   "locked": false,
   "index": "aC",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "CP: Left must be built before right. Order matters.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "CP: Left must be built before right. Order matters.",
   "lineHeight": 1.25,
   "autoResize": true
