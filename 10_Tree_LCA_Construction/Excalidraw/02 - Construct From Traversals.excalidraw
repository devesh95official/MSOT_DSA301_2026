   "index": "aG",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Postorder back is the root. Walk it backwards\nand build right before left.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Postorder back is the root. Walk it backwards\nand build right before left.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
