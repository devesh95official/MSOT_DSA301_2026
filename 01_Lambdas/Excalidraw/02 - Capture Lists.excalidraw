      "fontSize": 16,
      "fontFamily": 1,
      "text": "[] says what the lambda can see from outside.\nAn empty [] sees nothing.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[] says what the lambda can see from outside.\nAn empty [] sees nothing.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
