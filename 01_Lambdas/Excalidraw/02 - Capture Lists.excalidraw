      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 2,
      "text": "int n = 5;\nauto f = [](int x)  { return x + n; };   // error\nauto g = [n](int x) { return x + n; };   // ok",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int n = 5;\nauto f = [](int x)  { return x + n; };   // error\nauto g = [n](int x) { return x + n; };   // ok",
      "lineHeight": 1.25,
      "autoResize": true
    },
