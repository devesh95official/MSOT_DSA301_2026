      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 16,
      "fontFamily": 1,
      "text": "[] takes nothing. [=] takes copies.\nA copy is frozen at that moment.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[] takes nothing. [=] takes copies.\nA copy is frozen at that moment.",
      "lineHeight": 1.25,
      "autoResize": true
    },
