  {
   "id": "t012",
   "type": "text",
   "x": 192.1,
   "y": 671.06,
   "width": 448.8,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2005171404,
   "version": 2,
   "versionNonce": 234012233,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "bool ok(Node *r, long long lo, long long hi) {\n    if (!r) return true;\n    if (r->val <= lo || r->val >= hi) return false;\n    return ok(r->left, lo, r->val)\n        && ok(r->right, r->val, hi);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "bool ok(Node *r, long long lo, long long hi) {\n    if (!r) return true;\n    if (r->val <= lo || r->val >= hi) return false;\n    return ok(r->left, lo, r->val)\n        && ok(r->right, r->val, hi);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
