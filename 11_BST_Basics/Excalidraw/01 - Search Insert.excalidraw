   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "Node *find(Node *r, int x) {\n    while (r && r->val != x)\n        r = x < r->val ? r->left : r->right;\n    return r;\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Node *find(Node *r, int x) {\n    while (r && r->val != x)\n        r = x < r->val ? r->left : r->right;\n    return r;\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
