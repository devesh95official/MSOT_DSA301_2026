   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "Node *ins(Node *r, int x) {\n    if (!r) return new Node(x);\n    if (x < r->val) r->left = ins(r->left, x);\n    else r->right = ins(r->right, x);\n    return r;\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Node *ins(Node *r, int x) {\n    if (!r) return new Node(x);\n    if (x < r->val) r->left = ins(r->left, x);\n    else r->right = ins(r->right, x);\n    return r;\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
