   "link": null,
   "locked": false,
   "index": "aI",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "CP: O(h) space, amortised O(1) per next().",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "CP: O(h) space, amortised O(1) per next().",
   "lineHeight": 1.25,
   "autoResize": true
  },
