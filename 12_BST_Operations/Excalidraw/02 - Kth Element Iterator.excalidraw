   "index": "a4",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Inorder with a counter. Stop when the\ncounter reaches k.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Inorder with a counter. Stop when the\ncounter reaches k.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t006",
   "type": "text",
   "x": 195.32,
   "y": 341.5,
   "width": 290.4,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1154668289,
   "version": 2,
   "versionNonce": 1771293673,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "void go(Node *r) {\n    if (!r || cnt >= k) return;\n    go(r->left);\n    if (++cnt == k) ans = r->val;\n    go(r->right);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "void go(Node *r) {\n    if (!r || cnt >= k) return;\n    go(r->left);\n    if (++cnt == k) ans = r->val;\n    go(r->right);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t007",
