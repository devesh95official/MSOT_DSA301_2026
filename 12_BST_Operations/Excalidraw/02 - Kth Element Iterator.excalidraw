  {
   "id": "t017",
   "type": "text",
   "x": 181.5,
   "y": 908.73,
   "width": 412.16,
   "height": 40.0,
   "angle": 0.0005,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 539516447,
   "version": 2,
   "versionNonce": 856634196,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aG",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Push the whole left spine. next() pops,\nthen pushes the left spine of its right child.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Push the whole left spine. next() pops,\nthen pushes the left spine of its right child.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t018",
   "type": "text",
   "x": 195.5,
   "y": 960.73,
   "width": 369.6,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 576357906,
   "version": 2,
   "versionNonce": 493681991,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "int next() {\n    Node *n = st.top(); st.pop();\n    Node *c = n->right;\n    while (c) { st.push(c); c = c->left; }\n    return n->val;\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "int next() {\n    Node *n = st.top(); st.pop();\n    Node *c = n->right;\n    while (c) { st.push(c); c = c->left; }\n    return n->val;\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t019",
   "type": "text",
   "x": 181.5,
   "y": 1096.73,
   "width": 376.32,
   "height": 20.0,
   "angle": -0.0032,
   "strokeColor": "#1e1e1e",
