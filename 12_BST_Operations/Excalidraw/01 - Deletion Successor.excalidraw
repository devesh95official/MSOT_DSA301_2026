   "index": "aA",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Return the child, or null. The parent link\nis rewired by the return value.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Return the child, or null. The parent link\nis rewired by the return value.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t012",
   "type": "text",
   "x": 186.03,
   "y": 696.71,
   "width": 272.8,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
