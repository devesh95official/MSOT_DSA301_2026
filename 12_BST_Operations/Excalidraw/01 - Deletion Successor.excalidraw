  {
   "id": "t005",
   "type": "text",
   "x": 173.67,
   "y": 289.5,
   "width": 403.2,
   "height": 40.0,
   "angle": 0.0005,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2020775529,
   "version": 2,
   "versionNonce": 1924716090,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a4",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Smallest value greater than x. Go right once,\nthen left as far as possible.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Smallest value greater than x. Go right once,\nthen left as far as possible.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t006",
   "type": "text",
   "x": 187.67,
   "y": 341.5,
   "width": 396.0,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1456692075,
   "version": 2,
   "versionNonce": 775060661,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "Node *ans = nullptr;\nwhile (r) {\n    if (x < r->val) { ans = r; r = r->left; }\n    else r = r->right;\n}\nreturn ans;",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Node *ans = nullptr;\nwhile (r) {\n    if (x < r->val) { ans = r; r = r->left; }\n    else r = r->right;\n}\nreturn ans;",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
