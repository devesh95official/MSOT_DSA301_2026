   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "if (!r->left)  return r->right;\nif (!r->right) return r->left;",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "if (!r->left)  return r->right;\nif (!r->right) return r->left;",
   "lineHeight": 1.25,
   "autoResize": true
  },
