   "link": null,
   "locked": false,
   "index": "aG",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Copy in the successor's value, then delete\nthe successor from the right subtree.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Copy in the successor's value, then delete\nthe successor from the right subtree.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t018",
   "type": "text",
   "x": 195.12,
   "y": 975.33,
   "width": 290.4,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1761526520,
   "version": 2,
   "versionNonce": 78549664,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "Node *s = r->right;\nwhile (s->left) s = s->left;\nr->val = s->val;\nr->right = del(r->right, s->val);",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Node *s = r->right;\nwhile (s->left) s = s->left;\nr->val = s->val;\nr->right = del(r->right, s->val);",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
