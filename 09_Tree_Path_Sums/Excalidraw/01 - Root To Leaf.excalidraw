   "fontSize": 16,
   "fontFamily": 2,
   "text": "int go(Node *r, int cur) {\n    if (!r) return 0;\n    cur = cur * 10 + r->val;\n    if (!r->left && !r->right) return cur;\n    return go(r->left, cur) + go(r->right, cur);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "int go(Node *r, int cur) {\n    if (!r) return 0;\n    cur = cur * 10 + r->val;\n    if (!r->left && !r->right) return cur;\n    return go(r->left, cur) + go(r->right, cur);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
