   "index": "a4",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Subtract as you go down. At a leaf ask\nwhether the remainder is exactly 0.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Subtract as you go down. At a leaf ask\nwhether the remainder is exactly 0.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t006",
   "type": "text",
   "x": 190.47,
   "y": 341.5,
   "width": 440.0,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2021350329,
   "version": 2,
   "versionNonce": 71611768,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "bool has(Node *r, int t) {\n    if (!r) return false;\n    if (!r->left && !r->right) return t == r->val;\n    return has(r->left, t - r->val)\n        || has(r->right, t - r->val);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "bool has(Node *r, int t) {\n    if (!r) return false;\n    if (!r->left && !r->right) return t == r->val;\n    return has(r->left, t - r->val)\n        || has(r->right, t - r->val);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
