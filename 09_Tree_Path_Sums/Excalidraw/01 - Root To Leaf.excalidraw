   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "path.push_back(r->val);\nif (!r->left && !r->right) all.push_back(path);\nelse { go(r->left); go(r->right); }\npath.pop_back();",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "path.push_back(r->val);\nif (!r->left && !r->right) all.push_back(path);\nelse { go(r->left); go(r->right); }\npath.pop_back();",
   "lineHeight": 1.25,
   "autoResize": true
  },
