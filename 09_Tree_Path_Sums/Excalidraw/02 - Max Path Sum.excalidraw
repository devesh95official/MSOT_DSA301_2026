   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "int go(Node *r) {\n    if (!r) return 0;\n    int l = max(0, go(r->left));\n    int rr = max(0, go(r->right));\n    best = max(best, l + r->val + rr);\n    return r->val + max(l, rr);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "int go(Node *r) {\n    if (!r) return 0;\n    int l = max(0, go(r->left));\n    int rr = max(0, go(r->right));\n    best = max(best, l + r->val + rr);\n    return r->val + max(l, rr);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
