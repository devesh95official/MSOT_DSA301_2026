  {
   "id": "t018",
   "type": "text",
   "x": 187.02,
   "y": 877.98,
   "width": 334.4,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
