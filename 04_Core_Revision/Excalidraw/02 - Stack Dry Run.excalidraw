   "fontSize": 16,
   "fontFamily": 1,
   "text": "Last in, first out. All ops O(1).\ntop on an empty stack is undefined.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Last in, first out. All ops O(1).\ntop on an empty stack is undefined.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
