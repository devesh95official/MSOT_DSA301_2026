   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "for (int i = 0; i < n; i++) {\n    while (!st.empty() && a[st.top()] < a[i])\n        { ans[st.top()] = a[i]; st.pop(); }\n    st.push(i);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "for (int i = 0; i < n; i++) {\n    while (!st.empty() && a[st.top()] < a[i])\n        { ans[st.top()] = a[i]; st.pop(); }\n    st.push(i);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
