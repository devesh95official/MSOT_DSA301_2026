   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "stack<int> st;\nst.push(1); st.push(2);\ncout << st.top();       // 2\nst.pop();\ncout << st.size();      // 1",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "stack<int> st;\nst.push(1); st.push(2);\ncout << st.top();       // 2\nst.pop();\ncout << st.size();      // 1",
   "lineHeight": 1.25,
   "autoResize": true
  },
