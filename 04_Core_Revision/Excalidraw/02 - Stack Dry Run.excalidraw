   "index": "aG",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Keep the stack decreasing. Whatever pops out\nhas just found its next greater element.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Keep the stack decreasing. Whatever pops out\nhas just found its next greater element.",
   "lineHeight": 1.25,
