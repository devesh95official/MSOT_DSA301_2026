   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "for (char c : s) {\n    if (c == '(') st.push(c);\n    else { if (st.empty()) return false; st.pop(); }\n}\nreturn st.empty();",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "for (char c : s) {\n    if (c == '(') st.push(c);\n    else { if (st.empty()) return false; st.pop(); }\n}\nreturn st.empty();",
   "lineHeight": 1.25,
   "autoResize": true
  },
