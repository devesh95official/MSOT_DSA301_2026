   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "long long fact(int n) {\n    if (n <= 1) return 1;\n    return n * fact(n - 1);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "long long fact(int n) {\n    if (n <= 1) return 1;\n    return n * fact(n - 1);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
