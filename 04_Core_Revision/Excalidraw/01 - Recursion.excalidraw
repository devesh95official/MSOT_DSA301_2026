   "link": null,
   "locked": false,
   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "int fib(int n) {\n    if (n <= 1) return n;\n    return fib(n-1) + fib(n-2);\n}\n// fib(30) = 2692537 calls",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "int fib(int n) {\n    if (n <= 1) return n;\n    return fib(n-1) + fib(n-2);\n}\n// fib(30) = 2692537 calls",
   "lineHeight": 1.25,
   "autoResize": true
  },
