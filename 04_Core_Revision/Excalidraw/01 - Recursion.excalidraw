   "link": null,
   "locked": false,
   "index": "aG",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Cache each answer once. O(n) instead of O(2^n).",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Cache each answer once. O(n) instead of O(2^n).",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t018",
   "type": "text",
   "x": 197.46,
   "y": 970.33,
   "width": 466.4,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 720478822,
   "version": 2,
   "versionNonce": 1891856696,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "vector<long long> memo(n + 1, -1);\nauto f = [&](auto &self, int i) -> long long {\n    if (i <= 1) return i;\n    if (memo[i] != -1) return memo[i];\n    return memo[i] = self(self,i-1) + self(self,i-2);\n};",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "vector<long long> memo(n + 1, -1);\nauto f = [&](auto &self, int i) -> long long {\n    if (i <= 1) return i;\n    if (memo[i] != -1) return memo[i];\n    return memo[i] = self(self,i-1) + self(self,i-2);\n};",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
