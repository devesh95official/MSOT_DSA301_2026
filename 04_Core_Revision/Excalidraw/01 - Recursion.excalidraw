   "index": "aA",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Two calls per level means 2^n work.\nThe same subproblem is recomputed.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Two calls per level means 2^n work.\nThe same subproblem is recomputed.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t012",
   "type": "text",
   "x": 196.87,
   "y": 658.42,
   "width": 272.8,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
