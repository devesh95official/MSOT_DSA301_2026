   "index": "a4",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "No base case means infinite recursion.\nEvery call must move toward it.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "No base case means infinite recursion.\nEvery call must move toward it.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
