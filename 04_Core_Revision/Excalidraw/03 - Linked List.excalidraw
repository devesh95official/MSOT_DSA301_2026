   "index": "aG",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Three pointers. Flip one link per step.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Three pointers. Flip one link per step.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t018",
   "type": "text",
   "x": 196.27,
   "y": 956.46,
   "width": 352.0,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1274262018,
   "version": 2,
   "versionNonce": 103832368,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "Node *prev = nullptr, *cur = head, *nxt;\nwhile (cur) {\n    nxt = cur->next;\n    cur->next = prev;\n    prev = cur; cur = nxt;\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Node *prev = nullptr, *cur = head, *nxt;\nwhile (cur) {\n    nxt = cur->next;\n    cur->next = prev;\n    prev = cur; cur = nxt;\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
