   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aN",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "while (fast && fast->next) {\n    slow = slow->next;\n    fast = fast->next->next;\n    if (slow == fast) return true;   // cycle\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "while (fast && fast->next) {\n    slow = slow->next;\n    fast = fast->next->next;\n    if (slow == fast) return true;   // cycle\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
