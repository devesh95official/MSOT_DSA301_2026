   "text": "Fast moves two, slow moves one. Slow lands\non the middle. If they meet there is a cycle.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Fast moves two, slow moves one. Slow lands\non the middle. If they meet there is a cycle.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t024",
   "type": "text",
