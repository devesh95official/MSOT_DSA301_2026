   "index": "aA",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Minimising total waiting time: run the shortest\njob first. Each job delays all the ones after it.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Minimising total waiting time: run the shortest\njob first. Each job delays all the ones after it.",
   "lineHeight": 1.25,
   "autoResize": true
  },
