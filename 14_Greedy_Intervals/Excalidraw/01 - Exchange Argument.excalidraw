   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "sort(d.begin(), d.end());\nlong long wait = 0, total = 0;\nfor (int x : d) { total += wait; wait += x; }",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "sort(d.begin(), d.end());\nlong long wait = 0, total = 0;\nfor (int x : d) { total += wait; wait += x; }",
