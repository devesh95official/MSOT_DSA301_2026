   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "sort(v.begin(), v.end(), [](auto a, auto b) {\n    return a.second < b.second;\n});",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "sort(v.begin(), v.end(), [](auto a, auto b) {\n    return a.second < b.second;\n});",
   "lineHeight": 1.25,
   "autoResize": true
  },
