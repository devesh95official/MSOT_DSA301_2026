   "fontSize": 16,
   "fontFamily": 1,
   "text": "Sort by start. Extend the last interval when\nit overlaps, otherwise begin a new one.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Sort by start. Extend the last interval when\nit overlaps, otherwise begin a new one.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t006",
   "type": "text",
   "x": 190.24,
   "y": 341.5,
   "width": 475.2,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 696238729,
   "version": 2,
   "versionNonce": 292689397,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "sort(v.begin(), v.end());\nfor (auto [s, e] : v) {\n    if (!out.empty() && s <= out.back().second)\n        out.back().second = max(out.back().second, e);\n    else out.push_back({s, e});\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "sort(v.begin(), v.end());\nfor (auto [s, e] : v) {\n    if (!out.empty() && s <= out.back().second)\n        out.back().second = max(out.back().second, e);\n    else out.push_back({s, e});\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
