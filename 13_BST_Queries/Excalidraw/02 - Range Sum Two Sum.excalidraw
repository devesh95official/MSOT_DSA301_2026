   "index": "a4",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Use the invariant to prune. A whole subtree\ncan be skipped without looking inside.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Use the invariant to prune. A whole subtree\ncan be skipped without looking inside.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t006",
   "type": "text",
   "x": 190.43,
   "y": 341.5,
   "width": 440.0,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1133885770,
   "version": 2,
   "versionNonce": 550176432,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "int sum(Node *r, int lo, int hi) {\n    if (!r) return 0;\n    if (r->val < lo) return sum(r->right, lo, hi);\n    if (r->val > hi) return sum(r->left, lo, hi);\n    return r->val + sum(r->left, lo, hi)\n                  + sum(r->right, lo, hi);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "int sum(Node *r, int lo, int hi) {\n    if (!r) return 0;\n    if (r->val < lo) return sum(r->right, lo, hi);\n    if (r->val > hi) return sum(r->left, lo, hi);\n    return r->val + sum(r->left, lo, hi)\n                  + sum(r->right, lo, hi);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
