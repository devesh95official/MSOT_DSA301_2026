  {
   "id": "t017",
   "type": "text",
   "x": 175.44,
   "y": 923.61,
   "width": 340.48,
   "height": 40.0,
   "angle": -0.0032,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
