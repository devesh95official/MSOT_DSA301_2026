   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aG",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Inorder gives a sorted array. Then the\nstandard two-pointer walk.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Inorder gives a sorted array. Then the\nstandard two-pointer walk.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t018",
   "type": "text",
   "x": 189.44,
   "y": 975.61,
   "width": 246.4,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 38974754,
   "version": 2,
   "versionNonce": 618616336,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "int i = 0, j = n - 1;\nwhile (i < j) {\n    int s = a[i] + a[j];\n    if (s == t) return true;\n    s < t ? i++ : j--;\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "int i = 0, j = n - 1;\nwhile (i < j) {\n    int s = a[i] + a[j];\n    if (s == t) return true;\n    s < t ? i++ : j--;\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t019",
   "type": "text",
   "x": 175.44,
