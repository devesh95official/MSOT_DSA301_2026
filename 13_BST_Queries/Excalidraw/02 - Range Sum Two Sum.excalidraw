   "index": "aI",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "CP: O(n) time but O(n) space. Fine most of the time.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "CP: O(n) time but O(n) space. Fine most of the time.",
   "lineHeight": 1.25,
   "autoResize": true
  },
