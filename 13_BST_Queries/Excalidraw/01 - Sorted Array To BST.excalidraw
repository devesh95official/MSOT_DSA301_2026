   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "void flat(Node *r, vector<int> &out) {\n    if (!r) return;\n    flat(r->left, out);\n    out.push_back(r->val);\n    flat(r->right, out);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "void flat(Node *r, vector<int> &out) {\n    if (!r) return;\n    flat(r->left, out);\n    out.push_back(r->val);\n    flat(r->right, out);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
