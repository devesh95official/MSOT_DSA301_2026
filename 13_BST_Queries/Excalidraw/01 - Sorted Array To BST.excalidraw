   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a4",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "The middle element becomes the root. Both\nhalves get the same size, so it stays balanced.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The middle element becomes the root. Both\nhalves get the same size, so it stays balanced.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t006",
   "type": "text",
   "x": 186.88,
   "y": 341.5,
   "width": 448.8,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1064106225,
   "version": 2,
   "versionNonce": 678400089,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "int mid = (lo + hi) / 2;      // lo > hi -> nullptr\nNode *r = new Node(a[mid]);\nr->left  = build(a, lo, mid - 1);\nr->right = build(a, mid + 1, hi);\nreturn r;",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "int mid = (lo + hi) / 2;      // lo > hi -> nullptr\nNode *r = new Node(a[mid]);\nr->left  = build(a, lo, mid - 1);\nr->right = build(a, mid + 1, hi);\nreturn r;",
   "lineHeight": 1.25,
   "autoResize": true
  },
