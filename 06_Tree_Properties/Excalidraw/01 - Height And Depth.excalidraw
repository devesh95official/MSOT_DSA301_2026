   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "int height(Node *r) {\n    if (!r) return 0;\n    return 1 + max(height(r->left),\n                   height(r->right));\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "int height(Node *r) {\n    if (!r) return 0;\n    return 1 + max(height(r->left),\n                   height(r->right));\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
