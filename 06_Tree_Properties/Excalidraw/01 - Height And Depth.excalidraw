   "index": "aA",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "A null child is not a leaf. Taking plain min\nreturns 1 on a one-sided tree.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A null child is not a leaf. Taking plain min\nreturns 1 on a one-sided tree.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t012",
   "type": "text",
   "x": 189.32,
   "y": 671.69,
   "width": 396.0,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 440890159,
   "version": 2,
   "versionNonce": 1651448807,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "if (!r->left)  return 1 + minDepth(r->right);\nif (!r->right) return 1 + minDepth(r->left);\nreturn 1 + min(minDepth(r->left),\n               minDepth(r->right));",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "if (!r->left)  return 1 + minDepth(r->right);\nif (!r->right) return 1 + minDepth(r->left);\nreturn 1 + min(minDepth(r->left),\n               minDepth(r->right));",
   "lineHeight": 1.25,
   "autoResize": true
  },
