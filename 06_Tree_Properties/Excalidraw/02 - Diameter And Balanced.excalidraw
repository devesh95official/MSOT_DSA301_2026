   "index": "aG",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Longest path between any two nodes. It bends\nat some node: left height + right height.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Longest path between any two nodes. It bends\nat some node: left height + right height.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t018",
   "type": "text",
   "x": 197.83,
   "y": 1053.22,
   "width": 360.8,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 500653131,
   "version": 2,
   "versionNonce": 310101465,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "int h(Node *r) {\n    if (!r) return 0;\n    int l = h(r->left), rr = h(r->right);\n    best = max(best, l + rr);\n    return 1 + max(l, rr);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "int h(Node *r) {\n    if (!r) return 0;\n    int l = h(r->left), rr = h(r->right);\n    best = max(best, l + rr);\n    return 1 + max(l, rr);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
