   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "bool bal(Node *r) {\n    if (!r) return true;\n    if (abs(height(r->left) - height(r->right)) > 1)\n        return false;\n    return bal(r->left) && bal(r->right);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "bool bal(Node *r) {\n    if (!r) return true;\n    if (abs(height(r->left) - height(r->right)) > 1)\n        return false;\n    return bal(r->left) && bal(r->right);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
