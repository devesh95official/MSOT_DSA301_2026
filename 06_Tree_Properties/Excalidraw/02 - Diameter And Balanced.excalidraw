   "autoResize": true
  },
  {
   "id": "t006",
   "type": "text",
   "x": 187.78,
   "y": 341.5,
   "width": 457.6,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
