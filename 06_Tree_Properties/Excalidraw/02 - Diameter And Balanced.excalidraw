   "index": "a4",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Calling height at every node recomputes\neverything. O(n^2).",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Calling height at every node recomputes\neverything. O(n^2).",
