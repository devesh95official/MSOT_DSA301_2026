  },
  {
   "id": "t012",
   "type": "text",
   "x": 193.76,
   "y": 698.75,
   "width": 475.2,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1037580177,
   "version": 2,
   "versionNonce": 1185283583,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "int chk(Node *r) {\n    if (!r) return 0;\n    int l = chk(r->left), rr = chk(r->right);\n    if (l < 0 || rr < 0 || abs(l - rr) > 1) return -1;\n    return 1 + max(l, rr);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "int chk(Node *r) {\n    if (!r) return 0;\n    int l = chk(r->left), rr = chk(r->right);\n    if (l < 0 || rr < 0 || abs(l - rr) > 1) return -1;\n    return 1 + max(l, rr);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
