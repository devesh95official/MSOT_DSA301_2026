   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "sort(e.begin(), e.end(), [](Node a, Node b) {\n    if (a.w != b.w) return a.w < b.w;\n    return a.id < b.id;\n});",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "sort(e.begin(), e.end(), [](Node a, Node b) {\n    if (a.w != b.w) return a.w < b.w;\n    return a.id < b.id;\n});",
   "lineHeight": 1.25,
   "autoResize": true
  },
