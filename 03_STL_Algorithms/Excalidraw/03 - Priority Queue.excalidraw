      "index": "aH",
      "fontSize": 16,
      "fontFamily": 2,
      "text": "auto cmp = [](int a, int b) { return a > b; };\npriority_queue<int, vector<int>,\n    decltype(cmp)> pq(cmp);",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "auto cmp = [](int a, int b) { return a > b; };\npriority_queue<int, vector<int>,\n    decltype(cmp)> pq(cmp);",
      "lineHeight": 1.25,
      "autoResize": true
    },
