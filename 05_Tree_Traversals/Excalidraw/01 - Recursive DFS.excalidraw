   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "void pre(Node *r) {\n    if (!r) return;\n    cout << r->val;         // visit first\n    pre(r->left); pre(r->right);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "void pre(Node *r) {\n    if (!r) return;\n    cout << r->val;         // visit first\n    pre(r->left); pre(r->right);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
