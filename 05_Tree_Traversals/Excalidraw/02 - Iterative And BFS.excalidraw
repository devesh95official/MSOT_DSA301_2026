   "link": null,
   "locked": false,
   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "while (!st.empty()) {\n    Node *n = st.top(); st.pop();\n    cout << n->val;\n    if (n->right) st.push(n->right);\n    if (n->left)  st.push(n->left);\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "while (!st.empty()) {\n    Node *n = st.top(); st.pop();\n    cout << n->val;\n    if (n->right) st.push(n->right);\n    if (n->left)  st.push(n->left);\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
