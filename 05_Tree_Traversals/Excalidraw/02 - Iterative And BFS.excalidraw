   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "while (cur || !st.empty()) {\n    while (cur) { st.push(cur); cur = cur->left; }\n    cur = st.top(); st.pop();\n    cout << cur->val;\n    cur = cur->right;\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "while (cur || !st.empty()) {\n    while (cur) { st.push(cur); cur = cur->left; }\n    cur = st.top(); st.pop();\n    cout << cur->val;\n    cur = cur->right;\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
