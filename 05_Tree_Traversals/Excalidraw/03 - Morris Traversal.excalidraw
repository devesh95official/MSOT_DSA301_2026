   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aG",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "No thread yet: create it and go left.\nThread found: print, remove it, go right.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "No thread yet: create it and go left.\nThread found: print, remove it, go right.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t018",
   "type": "text",
   "x": 193.01,
   "y": 911.77,
   "width": 448.8,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1145776464,
   "version": 2,
   "versionNonce": 1032822302,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "if (!p->right) { p->right = cur; cur = cur->left; }\nelse { p->right = nullptr; cout << cur->val;\n       cur = cur->right; }",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "if (!p->right) { p->right = cur; cur = cur->left; }\nelse { p->right = nullptr; cout << cur->val;\n       cur = cur->right; }",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
