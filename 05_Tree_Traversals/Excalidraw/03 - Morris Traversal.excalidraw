   "link": null,
   "locked": false,
   "index": "aC",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "CP: The p->right != cur test finds an existing thread.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "CP: The p->right != cur test finds an existing thread.",
   "lineHeight": 1.25,
   "autoResize": true
  },
