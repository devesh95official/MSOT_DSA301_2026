  {
   "id": "t017",
   "type": "text",
   "x": 179.01,
   "y": 859.77,
   "width": 367.36,
   "height": 40.0,
   "angle": -0.0012,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
