   "link": null,
   "locked": false,
   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "// normal inorder: O(h) stack\n// Morris:         O(1) extra space",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "// normal inorder: O(h) stack\n// Morris:         O(1) extra space",
