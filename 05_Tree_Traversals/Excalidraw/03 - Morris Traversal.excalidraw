  {
   "id": "t011",
   "type": "text",
   "x": 175.47,
   "y": 567.71,
   "width": 394.24,
   "height": 40.0,
   "angle": 0.0029,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 245938877,
   "version": 2,
   "versionNonce": 265037303,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aA",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Find the inorder predecessor: rightmost node\nof the left subtree. Point it back at cur.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Find the inorder predecessor: rightmost node\nof the left subtree. Point it back at cur.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t012",
   "type": "text",
   "x": 189.47,
   "y": 619.71,
   "width": 308.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1462326252,
   "version": 2,
   "versionNonce": 297600141,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "Node *p = cur->left;\nwhile (p->right && p->right != cur)\n    p = p->right;",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Node *p = cur->left;\nwhile (p->right && p->right != cur)\n    p = p->right;",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t013",
   "type": "text",
   "x": 175.47,
   "y": 695.71,
   "width": 483.84,
   "height": 20.0,
   "angle": 0.0006,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
