   "roundness": null,
   "seed": 1612145948,
   "version": 2,
   "versionNonce": 1974889026,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a4",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Inorder in O(1) space. No stack, no recursion.\nIt borrows the null right pointers.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Inorder in O(1) space. No stack, no recursion.\nIt borrows the null right pointers.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t006",
   "type": "text",
   "x": 187.46,
   "y": 341.5,
   "width": 308.0,
   "height": 40.0,
