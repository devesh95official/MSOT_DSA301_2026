   "originalText": "Why Morris",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t005",
   "type": "text",
   "x": 173.46,
   "y": 289.5,
   "width": 412.16,
   "height": 40.0,
   "angle": -0.0013,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
