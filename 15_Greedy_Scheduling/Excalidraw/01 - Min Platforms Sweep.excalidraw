   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "sort(arr.begin(), arr.end());\nsort(dep.begin(), dep.end());\nif (arr[i] <= dep[j]) { cur++; i++; }\nelse { cur--; j++; }\nbest = max(best, cur);",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "sort(arr.begin(), arr.end());\nsort(dep.begin(), dep.end());\nif (arr[i] <= dep[j]) { cur++; i++; }\nelse { cur--; j++; }\nbest = max(best, cur);",
   "lineHeight": 1.25,
   "autoResize": true
  },
