   "index": "aB",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "if (w + it.w <= W) { w += it.w; val += it.v; }\nelse { val += it.v * (double)(W - w) / it.w;\n       break; }",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "if (w + it.w <= W) { w += it.w; val += it.v; }\nelse { val += it.v * (double)(W - w) / it.w;\n       break; }",
   "lineHeight": 1.25,
   "autoResize": true
  },
