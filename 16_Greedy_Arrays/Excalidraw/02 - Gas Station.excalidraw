   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "for (int i = 0; i < n; i++) {\n    int d = gas[i] - cost[i];\n    total += d; tank += d;\n    if (tank < 0) { start = i + 1; tank = 0; }\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "for (int i = 0; i < n; i++) {\n    int d = gas[i] - cost[i];\n    total += d; tank += d;\n    if (tank < 0) { start = i + 1; tank = 0; }\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
