   "index": "aG",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Keep the current level end and the furthest\nreachable. Bump the count when you hit the end.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Keep the current level end and the furthest\nreachable. Bump the count when you hit the end.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t018",
   "type": "text",
   "x": 188.97,
   "y": 941.36,
   "width": 360.8,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
