   "link": null,
   "locked": false,
   "index": "aH",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "for (int i = 0; i < n - 1; i++) {\n    far = max(far, i + a[i]);\n    if (i == end) { jumps++; end = far; }\n}",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "for (int i = 0; i < n - 1; i++) {\n    far = max(far, i + a[i]);\n    if (i == end) { jumps++; end = far; }\n}",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
