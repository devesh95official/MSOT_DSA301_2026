   "isDeleted": false,
   "boundElements": [],
   "updated": 1785318138681,
   "link": null,
   "locked": false,
   "index": "a5",
   "fontSize": 16,
   "fontFamily": 2,
   "text": "int reach = 0;\nfor (int i = 0; i < n; i++) {\n    if (i > reach) return false;\n    reach = max(reach, i + a[i]);\n}\nreturn true;",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "int reach = 0;\nfor (int i = 0; i < n; i++) {\n    if (i > reach) return false;\n    reach = max(reach, i + a[i]);\n}\nreturn true;",
   "lineHeight": 1.25,
   "autoResize": true
  },
