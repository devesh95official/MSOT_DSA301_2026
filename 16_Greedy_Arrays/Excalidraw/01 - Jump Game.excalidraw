   "index": "a4",
   "fontSize": 16,
   "fontFamily": 1,
   "text": "Track the furthest index reachable so far.\nIf you stand past it, you are stuck.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Track the furthest index reachable so far.\nIf you stand past it, you are stuck.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t006",
   "type": "text",
   "x": 195.75,
   "y": 341.5,
   "width": 290.4,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
